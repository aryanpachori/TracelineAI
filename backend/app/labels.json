  "grades": [
    {
      "letter": "A",
      "label": "Strong",
      "points": [
        90,
        100
      ],
      "when": "On the 5,000-customer underwriting ledger, EMI plus rent at or under the median 24% of earned inflow, and no bounce events.",
      "businessRate": [
        0.16,
        0.21
      ]
    },
    {
      "letter": "B",
      "label": "Acceptable",
      "points": [
        75,
        89
      ],
      "when": "EMI plus rent through the 75th percentile, 27% of earned inflow, and at most one bounce. Cash left stays positive.",
      "businessRate": [
        0.2,
        0.26
      ]
    },
    {
      "letter": "C",
      "label": "Watch",
      "points": [
        60,
        74
      ],
      "when": "EMI plus rent through the 90th percentile, 39% of earned inflow, or more than one bounce. Cash left is still positive.",
      "businessRate": [
        0.24,
        0.32
      ]
    },
    {
      "letter": "D",
      "label": "Weak",
      "points": [
        40,
        59
      ],
      "when": "Above that 39% obligation band, or several bounce events, or earned inflow too thin for the file.",
      "businessRate": [
        0.24,
        0.32
      ]
    },
    {
      "letter": "E",
      "label": "Not a fit",
      "points": [
        0,
        39
      ],
      "when": "Fewer than 6 months, or cash left is negative with returns, or the statement has almost no earned inflow.",
      "businessRate": [
        0.24,
        0.32
      ]
    }
  ],
  "notes": "Narration examples are rows from the Kaggle text sets and the underwriting ledger, mapped onto this file categories. Across 5,000 customers, EMI plus rent is 24% of income at the median, 27% at the 75th percentile, and 39% at the 90th. 2,602 customers have no bounce, 1,776 have one, and 622 have two or more, over 18 months. That ledger has loan types personal, home, auto, and mortgage, and no interest-rate column, so the rate bands stay the ones on this file. Working-capital rates sit about 2 points above the business band, capped at 30-34%. UPI merchant rates sit about 4 points above, capped at 36%, over 9 months. Amounts are calculated in code, not by the model.",
